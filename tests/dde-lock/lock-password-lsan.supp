# DTK6 offscreen preference object retained at application shutdown.
# Match only this external allocation; keep project leaks detectable.
leak:OrgDeepinDTKPreference::OrgDeepinDTKPreference

# Qt 6.8.0 retains a 16-byte gesture recognizer even after ungrabGesture.
# Reproduced with QApplication + QWidget + grabGesture/ungrabGesture only;
# see the implementation document. Keep all other Qt/project leaks detectable.
leak:QScroller::grabGesture
